# ── 서버 ─────────────────────────────────────────────────────────
# 부서원이 브라우저에 입력하는 주소. OIDC redirect_uri 가 <이 값>/api/auth/callback 이 됩니다.
PUBLIC_BASE_URL=http://10.0.0.10:8000
APP_PORT=8000
# '하루 1회' 사용 기록·월별 집계 기준 시간대
TIMEZONE=Asia/Seoul

# ── DB ───────────────────────────────────────────────────────────
# DB 접속 URL 에 그대로 들어가므로 영문·숫자로만 만드세요 (@ : / # 등은 URL 을 깨뜨립니다)
POSTGRES_PASSWORD=change-me

# ── 세션 ─────────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
SESSION_MAX_AGE_HOURS=12
# HTTPS 로 서비스할 때만 true
SESSION_COOKIE_SECURE=false

# ── 인증 ─────────────────────────────────────────────────────────
# local: 사번 + 비밀번호 (지금).  oidc: 사내 SSO (연동 준비되면 이 줄만 바꾸고 아래 OIDC_* 채우기)
AUTH_MODE=local
# local 모드에서 누구나 가입 가능한지. false 면 관리자가 '사용자 관리'에서 계정을 만듭니다.
LOCAL_SIGNUP=true
# 연속 로그인 실패 시 잠금 (횟수, 분)
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10

# 관리자 사번 (쉼표 구분). 해당 사번으로 가입·로그인하면 관리자 권한이 붙습니다.
ADMIN_IDS=

# ── 사내 SSO (OIDC) — AUTH_MODE=oidc 일 때만 ─────────────────────
OIDC_DISCOVERY_URL=https://sso.사내도메인/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# IdP 인증서가 사내 CA 로 서명돼 있으면 컨테이너 안 경로로 지정 (volumes 로 마운트)
OIDC_CA_BUNDLE=

# IdP 가 내려주는 claim 이름. 'org.dept' 처럼 점으로 중첩 claim 지정 가능
OIDC_CLAIM_ID=sub
OIDC_CLAIM_EMP_NO=employee_number
OIDC_CLAIM_NAME=name
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_DEPARTMENT=department

# ── AI 도우미 (탐색·추천 Agent) ──────────────────────────────────
# 사내 LLM 게이트웨이(Anthropic API 형식)에 붙은 Claude Code 로 동작합니다.
AGENT_ENABLED=false
ANTHROPIC_BASE_URL=https://llm-gw.사내도메인
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=qwen3
# 동시에 처리할 질문 수 (넘치면 대기열). 게이트웨이 동시 요청 한도에 맞추세요.
AGENT_MAX_CONCURRENT=3
# 질문 하나에 허용하는 최대 시간(초)
AGENT_TIMEOUT_SEC=180

# ── 첨부파일 ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=100
